<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#20FFFFFF">
    <item>
        <layer-list>
            <!-- Outer Soft Shadow for Clay/Glass Depth -->
            <item android:left="4dp" android:top="6dp" android:right="4dp" android:bottom="2dp">
                <shape android:shape="rectangle">
                    <corners android:radius="28dp" />
                    <solid android:color="#1A000000" />
                </shape>
            </item>
            <!-- Main Glass Card Surface with Gradient Fill -->
            <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="4dp">
                <shape android:shape="rectangle">
                    <corners android:radius="26dp" />
                    <gradient
                        android:angle="135"
                        android:startColor="#33FFFFFF"
                        android:centerColor="#1AFFFFFF"
                        android:endColor="#0DFFFFFF" />
                    <stroke
                        android:width="1.5dp"
                        android:color="#4DFFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>